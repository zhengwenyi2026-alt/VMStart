# VMStart Windows Cross-Compile Docker Image
# 用于在 Docker 中构建 Windows EXE（x86_64 和 arm64）
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS builder

WORKDIR /src
COPY VMStart-Windows/ ./VMStart-Windows/

# 默认构建 x86_64
ARG TARGET_ARCH=win-x64
ARG VERSION=1.0.0

RUN cd VMStart-Windows/VMStart && \
    dotnet publish -c Release \
        -r ${TARGET_ARCH} \
        --self-contained true \
        -p:PublishSingleFile=true \
        -p:IncludeNativeLibrariesForSelfExtract=true \
        -p:DebugType=None \
        -p:EnableWindowsTargeting=true \
        -o /output

FROM mcr.microsoft.com/dotnet/runtime-deps:8.0 AS output
ARG TARGET_ARCH=win-x64
ARG VERSION=1.0.0

WORKDIR /output
COPY --from=builder /output/ .

# 输出文件信息
RUN ls -la /output/
CMD ["echo", "Build complete. Copy from /output/VMStart.exe"]
