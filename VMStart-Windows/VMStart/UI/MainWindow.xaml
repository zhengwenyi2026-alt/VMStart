<Window x:Class="VMStart.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VMStart" Width="1060" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Title -->
                <StackPanel DockPanel.Dock="Top" Margin="20,16,20,0">
                    <TextBlock Text="VMStart" FontSize="22" FontWeight="Bold" Foreground="#1A1A2E"/>
                    <TextBlock Text="Virtual Machine Manager" FontSize="11" Foreground="#999" Margin="0,2,0,12"/>
                    <TextBox x:Name="SearchBox" Padding="6,4" BorderThickness="1" BorderBrush="#DDD"
                             TextChanged="SearchBox_TextChanged" Tag="Search VMs...">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search VMs..." Foreground="#AAA" Margin="6,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- Group Header -->
                <TextBlock DockPanel.Dock="Top" Text="MY VIRTUAL MACHINES" FontSize="10" FontWeight="Bold"
                           Foreground="#AAA" Margin="20,16,0,8"/>

                <!-- Bottom Toolbar -->
                <Border DockPanel.Dock="Bottom" Height="44" Background="#F0F0F0">
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <Button Click="AddVM_Click" ToolTip="New VM" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="18" Content="+"/>
                        <Button Click="RemoveVM_Click" ToolTip="Remove VM" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="18" Content="-" Margin="4,0"/>
                        <Button Click="EditVM_Click" ToolTip="Settings" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Content="⚙" Margin="4,0"/>
                        <Button Click="StartVM_Click" ToolTip="Start VM" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Content="▶" Margin="4,0"/>
                        <Border Width="1" Background="#DDD" Margin="8,6"/>
                        <!-- Mode Switcher -->
                        <Border CornerRadius="6" Background="#E8E8E8" Margin="8,6" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SimpleBtn" Content="Simple" Click="ModeSwitch_Click" Tag="0"
                                        Background="Transparent" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand"/>
                                <Button x:Name="StandardBtn" Content="Standard" Click="ModeSwitch_Click" Tag="1"
                                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand"/>
                                <Button x:Name="AdvancedBtn" Content="Advanced" Click="ModeSwitch_Click" Tag="2"
                                        Background="Transparent" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- VM List -->
                <ListBox x:Name="VMList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="VMList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True" Drop="VMList_Drop" PreviewDragOver="VMList_DragOver">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="▶ Start" Click="CtxStart_Click"/>
                            <MenuItem Header="⏹ Stop" Click="CtxStop_Click"/>
                            <MenuItem Header="⏸ Pause" Click="CtxPause_Click"/>
                            <Separator/>
                            <MenuItem Header="⚙ Settings" Click="EditVM_Click"/>
                            <MenuItem Header="🖥 Open Console" Click="CtxConsole_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CtxFavoriteItem" Header="☆ Add to Favorites" Click="CtxFavorite_Click"/>
                            <MenuItem Header="📁 Set Group..." Click="CtxSetGroup_Click"/>
                            <Separator/>
                            <MenuItem Header="📷 Snapshots">
                                <MenuItem Header="Take Snapshot..." Click="CtxTakeSnapshot_Click"/>
                                <MenuItem Header="Restore Snapshot..." Click="CtxRestoreSnapshot_Click"/>
                                <MenuItem Header="Delete Snapshot..." Click="CtxDeleteSnapshot_Click"/>
                            </MenuItem>
                            <MenuItem Header="📑 Clone">
                                <MenuItem Header="Full Clone..." Click="CtxFullClone_Click"/>
                                <MenuItem Header="Linked Clone..." Click="CtxLinkedClone_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="📤 Export OVF..." Click="CtxExportOVF_Click"/>
                            <Separator/>
                            <MenuItem Header="🗑 Delete" Click="RemoveVM_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48" Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,4,0"/>
                                    <TextBlock Text="🖥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="#333"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="#999">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} • {1}">
                                                <Binding Path="ArchitectureDisplayName"/>
                                                <Binding Path="StatusDisplayName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <!-- Welcome View (empty state) -->
            <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                <TextBlock Text="🖥" FontSize="64" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,16"/>
                <TextBlock Text="Welcome to VMStart" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333"/>
                <TextBlock Text="Create and manage virtual machines&#x0a;for various operating systems and architectures."
                           FontSize="13" Foreground="#999" TextAlignment="Center" Margin="0,8,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="+ Create New VM" Style="{StaticResource PrimaryButton}" Click="AddVM_Click" Margin="0,0,12,0"/>
                    <Button Content="📂 Open Existing VM" Padding="16,8" BorderBrush="#DDD" Background="White" Click="OpenVM_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Details View -->
            <ScrollViewer x:Name="DetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- Header Card -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🖥" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                                <Border x:Name="DetailArchBadge" Background="{StaticResource PrimaryBrush}" CornerRadius="4"
                                        Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,4">
                                    <TextBlock x:Name="DetailArch" FontSize="11" Foreground="White" FontWeight="Medium"/>
                                </Border>
                                <Border x:Name="DetailStatusBadge" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock x:Name="DetailStatus" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="StartBtn" Content="▶ Start" Style="{StaticResource PrimaryButton}" Click="StartVM_Click" Margin="0,0,0,8"/>
                                <Button Content="⚙ Settings" Padding="16,6" Click="EditVM_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Section Header -->
                    <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="Bold" Foreground="#AAA" Margin="8,0,0,8"/>

                    <!-- Info Cards Grid -->
                    <WrapPanel>
                        <!-- Processor -->
                        <Border Style="{StaticResource CardBorder}" Width="240">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔲" FontSize="16" Margin="0,0,8,0" Opacity="0.5"/>
                                    <TextBlock Text="Processor" FontSize="10" Foreground="#999" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailCPU" FontSize="12" FontWeight="Medium" Foreground="#333" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Memory -->
                        <Border Style="{StaticResource CardBorder}" Width="240">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0" Opacity="0.5"/>
                                    <TextBlock Text="Memory" FontSize="10" Foreground="#999" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailMemory" FontSize="12" FontWeight="Medium" Foreground="#333" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Storage -->
                        <Border Style="{StaticResource CardBorder}" Width="240">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💿" FontSize="16" Margin="0,0,8,0" Opacity="0.5"/>
                                    <TextBlock Text="Storage" FontSize="10" Foreground="#999" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailDisk" FontSize="12" FontWeight="Medium" Foreground="#333" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Network -->
                        <Border Style="{StaticResource CardBorder}" Width="240">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="16" Margin="0,0,8,0" Opacity="0.5"/>
                                    <TextBlock Text="Network" FontSize="10" Foreground="#999" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailNetwork" FontSize="12" FontWeight="Medium" Foreground="#333" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Display -->
                        <Border Style="{StaticResource CardBorder}" Width="240">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖥" FontSize="16" Margin="0,0,8,0" Opacity="0.5"/>
                                    <TextBlock Text="Display" FontSize="10" Foreground="#999" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailDisplay" FontSize="12" FontWeight="Medium" Foreground="#333" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Status -->
                        <Border Style="{StaticResource CardBorder}" Width="240">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ" FontSize="16" Margin="0,0,8,0" Opacity="0.5"/>
                                    <TextBlock Text="Status" FontSize="10" Foreground="#999" FontWeight="Medium"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailStatusInfo" FontSize="12" FontWeight="Medium" Foreground="#333" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Notes Section (Advanced mode) -->
                    <Border x:Name="NotesCard" Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="#AAA"/>
                            <TextBlock x:Name="DetailNotes" FontSize="11" Foreground="#666" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Column="1" VerticalAlignment="Bottom" Height="24" Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusBar" FontSize="10" Foreground="#999" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
